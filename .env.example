# ─── Northstar Environment Configuration ──────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# Never commit `.env` to source control.

# ─── OpenAI Provider (optional) ───────────────────────────────────────────────
# Set OPENAI_API_KEY to connect Northstar to the OpenAI API.
# Leave empty to use the built-in Northstar Heuristic Model (deterministic).
OPENAI_API_KEY=

# OpenAI base URL (override for Azure, LiteLLM, or compatible proxies)
OPENAI_BASE_URL=https://api.openai.com/v1

# Model to use with OpenAI provider
# Recommended: gpt-4o-mini (cost-efficient) or gpt-4o (highest quality)
OPENAI_MODEL=gpt-4o-mini

# ─── Ollama Local Provider (optional) ─────────────────────────────────────────
# Set OLLAMA_ENABLED=true to use a locally running Ollama instance.
# Ollama is checked only when OPENAI_API_KEY is NOT set.
OLLAMA_ENABLED=false

# Base URL of your Ollama HTTP server
OLLAMA_BASE_URL=http://localhost:11434

# Model loaded in Ollama to use for inference
# Recommended: qwen3:4b (fast), llama3:8b (balanced), mistral:7b
OLLAMA_MODEL=qwen3:4b

# ─── Application Settings (optional) ──────────────────────────────────────────
# Override the application name shown in the FastAPI docs
# APP_NAME=Northstar

# ─── Notes ────────────────────────────────────────────────────────────────────
# Provider selection logic (priority order):
#   1. OPENAI_API_KEY set → OpenAI API is used
#   2. OLLAMA_ENABLED=true → Local Ollama server is used
#   3. Neither → Northstar Heuristic Model (deterministic fallback, always works)
#
# The Heuristic Model uses multi-factor drift scoring without any external API.
# It is fully functional for demos, testing, and CI environments.
